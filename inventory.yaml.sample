ansible:
  hosts:
    controller1:
      ansible_host: localhost

lab:
  hosts:
    node1:
      ansible_host: 192.168.10.1
      ansible_ssh_private_key_file: ~/.ssh/node01
      ansible_python_interpreter: /usr/bin/python3.14
    node2:
      ansible_host: 192.168.10.2
      ansible_ssh_private_key_file: ~/.ssh/node02
      ansible_python_interpreter: /usr/bin/python3.14
    node3:
      ansible_host: 192.168.10.3
      ansible_ssh_private_key_file: ~/.ssh/node03
      ansible_python_interpreter: /usr/bin/python3.14
